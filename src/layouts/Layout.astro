---
import '@fontsource-variable/manrope';
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import WhatsApp from '../components/WhatsApp.astro';
import WhatsAppMark from '../components/WhatsAppMark.astro';
import { contact } from '../data/contacto';
import { company } from '../data/empresa';
import { images } from '../data/imagenes';
import { pathUrl,whatsapp } from '../lib/links';
import {serializeJsonLd} from '../lib/json-ld';
interface Props { title: string; description: string; noindex?: boolean; }
const {title,description,noindex=false}=Astro.props;
const indexable=import.meta.env.PUBLIC_INDEXABLE==='true' && Boolean(Astro.site) && !noindex;
const canonical=Astro.site ? new URL(Astro.url.pathname,Astro.site).href : undefined;
const nav=[['Inicio',''],['Préstamos','prestamos/'],['Simulador','simulador/'],['Nosotros','nosotros/'],['Contacto','contacto/']];
const structured={'@context':'https://schema.org','@type':'Organization',name:company.name,...(Astro.site?{url:Astro.site.href}:{}),telephone:contact.phone,address:{'@type':'PostalAddress',streetAddress:contact.street,addressLocality:contact.locality,addressRegion:contact.region,addressCountry:contact.country}};
---
<!doctype html>
<html lang="es-PE">
  <head>
    <meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
    <title>{title} | Prestysull</title><meta name="description" content={description}/>
    <meta name="theme-color" content="#102A4C"/><meta name="robots" content={indexable?'index,follow':'noindex,nofollow'}/>
    {canonical && <link rel="canonical" href={canonical}/>}
    <link rel="icon" type="image/jpeg" href={pathUrl(images.logo)}/>
    <meta property="og:title" content={`${title} | Prestysull`}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><meta property="og:locale" content="es_PE"/>
    {canonical && <meta property="og:url" content={canonical}/>}
    <script type="application/ld+json" set:html={serializeJsonLd(structured)}/>
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <div class="topbar"><span><Icon name="pin" size={14}/> Cerca de ti, en {contact.locality}</span><a href={pathUrl('contacto/')}>Visítanos en {contact.street} <Icon name="arrow" size={14}/></a></div>
    <header class="header">
      <div class="nav-wrap container">
        <a class="brand" href={pathUrl()} aria-label="Prestysull — inicio"><img src={pathUrl(images.logo)} width="682" height="602" alt="Prestysull"/></a>
        <button class="menu-toggle" aria-expanded="false" aria-controls="main-nav" aria-label="Abrir menú"><Icon name="menu"/></button>
        <nav id="main-nav" aria-label="Navegación principal">{nav.map(([name,path])=><a href={pathUrl(path)} aria-current={Astro.url.pathname===pathUrl(path)?'page':undefined}>{name}</a>)}</nav>
        <div class="nav-contact"><WhatsApp label="Hablemos" variant="nav-button"/></div>
      </div>
    </header>
    <main id="contenido"><slot/></main>
    <footer>
      <div class="container footer-grid">
        <div><a class="footer-brand" href={pathUrl()}><img src={pathUrl(images.logo)} width="682" height="602" alt="Prestysull — inicio"/></a><p>{company.tagline}</p><span class="small">{contact.city}.</span></div>
        <div><h2>Tu siguiente paso</h2><a href={pathUrl('prestamos/semanal/')}>Préstamo semanal</a><a href={pathUrl('prestamos/catorcenal/')}>Préstamo catorcenal</a><a href={pathUrl('simulador/')}>Simula tu préstamo</a></div>
        <div><h2>Conócenos</h2><a href={pathUrl('nosotros/')}>Sobre Prestysull</a><a href={pathUrl('contacto/')}>Contacto y ubicación</a><a href={pathUrl('#preguntas')}>Preguntas frecuentes</a><a href={pathUrl('privacidad/')}>Política de privacidad</a></div>
        <div><h2>Estamos cerca</h2><a href={whatsapp()} target="_blank" rel="noopener noreferrer"><span class="whatsapp-icon"><WhatsAppMark size={16}/></span>{contact.phone} <Icon name="up" size={16}/></a><p>{contact.address}</p><p>{contact.days}<br/>{contact.hours}</p></div>
      </div>
      <div class="container footer-bottom"><span>© {new Date().getFullYear()} Prestysull</span><span>Financiamiento sujeto a evaluación y aprobación.</span><span>Hecho para dar el siguiente paso.</span></div>
    </footer>
    <a class="floating-wa" href={whatsapp()} target="_blank" rel="noopener noreferrer" aria-label="Consultar por WhatsApp (abre una nueva pestaña)"><span class="whatsapp-icon"><WhatsAppMark size={25}/></span><span>¿Conversamos?</span></a>
    <script src="../scripts/site.ts"></script>
  </body>
</html>
