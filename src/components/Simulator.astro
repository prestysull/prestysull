---
import Icon from './Icon.astro';
import WhatsApp from './WhatsApp.astro';
import {simulator} from '../data/simulador';
import {loans} from '../data/prestamos';
import {calendar} from '../data/feriados';
---
<div class="simulator" id="simulador">
  <div class="simulator-grid">
    <form class="calculator-form" novalidate>
      <fieldset disabled id="calculator-fields"><legend class="sr-only">Configura tu simulación</legend>
        <div class="form-heading"><span class="icon-tile"><Icon name="sliders"/></span><div><h2>Hagamos números.</h2><p>Explora un escenario referencial.</p></div></div>
        <fieldset class="mode-picker"><legend>1. Elige una modalidad</legend><div>{Object.entries(loans).map(([key,loan])=><label><input type="radio" name="mode" value={key} checked={key==='semanal'}/><span><Icon name={loan.icon}/><b>{key==='semanal'?'Semanal':'Catorcenal'}</b><small>Cada {loan.days} días</small></span></label>)}</div></fieldset>
        <label for="capital">2. ¿Cuánto quieres simular?</label><div class="money-input"><span>S/</span><input id="capital" name="capital" type="text" inputmode="decimal" value={simulator.defaultCapital} required maxlength="12" aria-describedby="capital-help calc-error" autocomplete="off"/></div><p class="field-hint" id="capital-help">Desde S/ 500. El monto final depende de tu evaluación.</p>
        <div class="field-pair"><div><label for="rate">Tasa de la operación</label><select id="rate" name="rate">{simulator.rates.map(r=><option value={r} selected={r===simulator.defaultRate}>{r}%</option>)}</select></div><div><label for="count">Número de cuotas</label><select id="count" name="count" aria-describedby="count-help">{Array.from({length:loans.semanal.maxInstallments},(_,i)=>i+1).map(n=><option value={n} selected={n===simulator.defaultCount}>{n} cuotas</option>)}</select></div></div>
        <p class="field-hint" id="count-help">{simulator.installmentNotice}</p>
        <label for="date">Fecha de desembolso estimada</label><input type="date" id="date" name="date" required aria-describedby="date-help"/><p class="field-hint" id="date-help">Solo para el cálculo. No representa una fecha de desembolso acordada.</p>
        <p id="calc-error" class="form-error" role="alert" hidden></p><button class="button primary calculate-button" type="submit">Calcular mi escenario <Icon name="arrow" size={20}/></button>
        <p class="privacy-note"><Icon name="shield" size={16}/> Tus datos se quedan en este dispositivo.</p>
      </fieldset>
    </form>
    <div class="calculator-output"><p class="eyebrow">Para verlo con claridad</p><div id="calc-status" role="status" aria-live="polite"><p>Preparando calculadora…</p></div><div id="calc-result" hidden><div class="installment-output"><span>Cuota base referencial</span><strong data-result="installment"></strong><p data-result="frequency"></p></div><dl class="cost-breakdown"><div><dt>Capital</dt><dd data-result="capital"></dd></div><div><dt>Interés de toda la operación</dt><dd data-result="interest"></dd></div><div><dt>Seguro ({simulator.insurancePercent}% del capital)</dt><dd data-result="insurance"></dd></div><div class="total"><dt>Total a pagar</dt><dd data-result="total"></dd></div></dl><p class="small" data-result="rounding"></p><WhatsApp context="simulador" label="Consultar por WhatsApp" variant="lime"/><p class="small">Se abrirá un mensaje general. Los valores de tu simulación no se envían automáticamente.</p></div><div class="financial-notice"><Icon name="document"/><p>{simulator.warning}</p></div></div>
  </div>
  <noscript><p class="notice">Activa JavaScript para utilizar el simulador. También puedes consultar directamente por WhatsApp. No se guardan ni se envían los valores introducidos.</p></noscript>
  <section class="schedule-section" id="schedule-section" hidden><div class="section-heading"><div><p class="eyebrow">Paso a paso, cuota a cuota</p><h2>Tu cronograma estimado.</h2></div><p>La última cuota puede variar unos céntimos para que la suma coincida exactamente con el total.</p></div><p class="notice calendar-notice" id="calendar-notice"></p><div class="table-wrap" tabindex="0" role="region" aria-label="Cronograma estimado, desplazable horizontalmente"><table><caption class="sr-only">Fechas e importes de las cuotas de la simulación</caption><thead><tr><th scope="col">Cuota</th><th scope="col">Fecha base</th><th scope="col">Fecha estimada ajustada</th><th scope="col">Importe</th></tr></thead><tbody id="schedule-body"></tbody><tfoot><tr><th scope="row" colspan="3">Total a pagar</th><td data-result="schedule-total"></td></tr></tfoot></table></div><p class="small">{simulator.calendarNotice} Feriados nacionales revisados: {calendar.years.join(', ')}. Los feriados locales y los días de atención requieren confirmación.</p></section>
</div>
<script src="../scripts/simulator.ts"></script>
