---
import { loans } from '../data/prestamos';
import {pathUrl} from '../lib/links';
import Icon from './Icon.astro';
import WhatsApp from './WhatsApp.astro';
---
<div class="loan-grid">{Object.entries(loans).map(([key,loan],i)=><article class:list={['loan-card',i===1?'loan-light':'loan-dark','reveal']} data-loan-card>
  <span class="card-light" data-card-light aria-hidden="true"></span>
  <div class="card-top"><span class="icon-tile"><Icon name={loan.icon} size={30}/></span><span class="pill">Cada {loan.days} días</span></div>
  <p class="eyebrow">{loan.audience}</p><h3>{loan.name}</h3><p>{loan.short}</p>
  <div class="loan-limit"><span>Hasta <b>{loan.maxInstallments}</b> cuotas</span><Icon name="calendar"/></div>
  <div class="card-actions"><a class="text-link" href={pathUrl(`prestamos/${key}/`)}>Conocer requisitos <Icon name="arrow" size={20}/></a><WhatsApp context={key as 'semanal'|'catorcenal'} label="Consultar" variant="compact"/></div>
</article>)}</div>
