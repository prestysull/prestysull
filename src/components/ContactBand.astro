---
import WhatsApp from './WhatsApp.astro';
import Icon from './Icon.astro';
import {contact} from '../data/contacto';
import {pathUrl} from '../lib/links';
---
<section class="contact-band section"><div class="container contact-inner"><div><p class="eyebrow">Las buenas ideas empiezan conversando</p><h2>Cuéntanos.<br/>¿Cuál es tu siguiente meta?</h2><WhatsApp variant="lime"/></div><div class="contact-note"><span class="icon-tile"><Icon name="pin" size={28}/></span><h3>Nos encontramos en Sullana.</h3><p>{contact.address}<br/>{contact.days}, {contact.hours}</p><a class="text-link" href={pathUrl('contacto/')}>Cómo llegar <Icon name="arrow" size={20}/></a></div></div></section>
