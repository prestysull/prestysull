---
import WhatsApp from './WhatsApp.astro';
import Icon from './Icon.astro';
import {contact} from '../data/contacto';
import {pathUrl} from '../lib/links';
const copy=contact.band;
---
<section class="contact-band section"><div class="container contact-inner"><div><p class="eyebrow">{copy.eyebrow}</p><h2>{copy.title}<br/>{copy.titleAccent}</h2><WhatsApp variant="lime"/></div><div class="contact-note"><span class="icon-tile"><Icon name="pin" size={28}/></span><h3>{copy.locationTitle}</h3><p>{contact.address}<br/>{contact.days}, {contact.hours}</p><a class="text-link" href={pathUrl('contacto/')}>{copy.locationLink} <Icon name="arrow" size={20}/></a></div></div></section>
