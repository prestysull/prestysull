---
import Icon from './Icon.astro';
import WhatsAppMark from './WhatsAppMark.astro';
import { whatsapp } from '../lib/links';
import type { messages } from '../data/contacto';
interface Props { context?: keyof typeof messages; label?: string; variant?: string; }
const {context='general',label='Conversemos por WhatsApp',variant='primary'}=Astro.props;
---
<a class:list={['button',variant]} href={whatsapp(context)} target="_blank" rel="noopener noreferrer"><span class="whatsapp-icon"><WhatsAppMark/></span><span>{label}</span><Icon name="up" size={18}/></a>
