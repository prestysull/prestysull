---
import Layout from '../layouts/Layout.astro';
import {Image} from 'astro:assets';
import {images} from '../data/imagenes';
const photo=images.commerce;
import {company} from '../data/empresa';
import ContactBand from '../components/ContactBand.astro';
const copy=company.page;
---
<Layout title="Conoce Prestysull en Sullana" description="Prestysull opera en Sullana, Piura, con préstamos semanales y catorcenales sujetos a evaluación. Conoce nuestra atención local."><section class="container page-intro"><p class="eyebrow">{copy.eyebrow}</p><h1>{copy.title}<br/><span>{copy.titleAccent}</span></h1><p>{company.about}</p></section><section class="container section section-topless about-page"><Image src={photo} alt="Comerciante ficticia en una escena ilustrativa creada con IA" widths={[600,1000,1400]} sizes="(max-width: 760px) 100vw, 80vw" format="webp" loading="eager"/><div class="section-heading"><h2>{copy.sectionTitle}<br/>{copy.sectionTitleAccent}</h2><p>{copy.sectionDescription}</p></div>{import.meta.env.DEV && <div class="institution-demo"><p class="draft-note">Demostración editorial · Oculta en producción · Requiere aprobación de Prestysull.</p><div class="institution-grid">{company.demo.map(d=><article><h3>{d.title}</h3><p>{d.text}</p></article>)}</div></div>}</section><ContactBand/></Layout>
