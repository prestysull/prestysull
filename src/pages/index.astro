---
import Layout from '../layouts/Layout.astro';
import {images} from '../data/imagenes';
const photo=images.commerce;
import Icon from '../components/Icon.astro';
import WhatsApp from '../components/WhatsApp.astro';
import WhatsAppMark from '../components/WhatsAppMark.astro';
import LoanCards from '../components/LoanCards.astro';
import FAQ from '../components/FAQ.astro';
import ContactBand from '../components/ContactBand.astro';
import Testimonials from '../components/Testimonials.astro';
import {company} from '../data/empresa';
import {processSteps} from '../data/prestamos';
import {simulator} from '../data/simulador';
import {formatMoney,simulate} from '../lib/finance';
import {pathUrl} from '../lib/links';
import {cmsContent} from '../lib/content';
const example=simulate(simulator.defaultCapital,simulator.defaultRate,simulator.defaultCount,'semanal');
const home=cmsContent.home;
---
<Layout title="Préstamos en Sullana para tu siguiente paso" description="Conoce los préstamos semanales y catorcenales de Prestysull en Sullana. Revisa requisitos, simula tus cuotas y consulta por WhatsApp.">
  <section class="hero container">
    <div class="hero-copy">
      <p class="eyebrow enter"><span class="status-dot"></span> {home.heroEyebrow}</p>
      <h1 class="enter" style="--order:1">{company.heroLines.map((line,i)=>i===company.heroLines.length-1?<span>{line}</span>:<>{line}<br/></>)}<svg class="headline-stroke" viewBox="0 0 430 20" aria-hidden="true"><path d="M3 12Q195-4 425 9"/></svg></h1>
      <p class="hero-description enter" style="--order:2">{company.intro}</p>
      <div class="hero-actions enter" style="--order:3"><WhatsApp/><a class="text-link" href={pathUrl('simulador/')}>Simular mi préstamo <Icon name="arrow" size={19}/></a></div>
      <p class="hero-footnote enter" style="--order:4"><Icon name="shield" size={17}/> {home.heroTrust}</p>
    </div>
    <div class="hero-visual enter" style="--order:2">
      <div class="orbit orbit-one" aria-hidden="true" data-parallax="0.045"></div>
      <figure class="hero-photo" data-hero-gallery data-active-slide="0" tabindex="0" aria-label="Galería de personas que trabajan por sus metas. Desliza o usa las flechas izquierda y derecha para cambiar de imagen.">
        <div class="hero-slides">
          {images.hero.map((scene,i)=><div class:list={['hero-slide',i===0&&'is-active',i===1&&'is-stack-near',i===2&&'is-stack-far']} data-hero-slide data-hero-stack data-hero-stack-index={i} aria-hidden={i===0?'false':'true'}>
            <img src={scene.src} alt={scene.alt} sizes="(max-width: 760px) 100vw, 48vw" loading={i===0?'eager':'lazy'} fetchpriority={i===0?'high':'auto'} decoding="async"/>
          </div>)}
        </div>
      </figure>
      <button class="round-sticker" type="button" data-hero-next aria-label="Ver siguiente imagen"><Icon name="up" size={45}/></button>
      <span class="photo-location"><Icon name="pin" size={15}/> Pensado para Sullana</span>
    </div>
  </section>
  <div class="local-strip"><div class="container"><span><Icon name="pin"/> Cobertura en todo Sullana</span><span><Icon name="chat"/> Consulta directa por WhatsApp</span><span><Icon name="document"/> Formalización en oficina</span></div></div>
  <section class="section container" id="modalidades"><div class="section-heading reveal"><div><p class="eyebrow">{home.loans.eyebrow}</p><h2>{home.loans.title}<br/><span>{home.loans.titleAccent}</span></h2></div><p>{home.loans.description}</p></div><LoanCards/><p class="section-footnote">{home.loans.footnote}</p></section>
  <section class="process-section section" id="como-funciona"><div class="container process-grid"><div class="process-sticky"><p class="eyebrow">{home.process.eyebrow}</p><h2>{home.process.title}<br/><span>{home.process.titleAccent}</span></h2><p>{home.process.description}</p><div class="process-art" data-scene="0" aria-hidden="true"><div class="process-orbit"></div><div class="process-visual-stage">{processSteps.map((step,i)=><div class:list={['process-scene',i===0&&'is-active']} data-process-scene data-scene-index={i}><span class="process-scene-icon">{i===0?<WhatsAppMark size={38}/>:<Icon name={step.icon} size={38}/>}</span><span class="scene-rail"><i></i><i></i><i></i></span><span class="scene-pulse"></span></div>)}</div><span class="process-counter"><b data-step-number>01</b><span>/ 06</span></span><p data-step-title>{processSteps[0].title}</p><div class="step-progress"><span></span></div></div><span class="small">{home.process.disclaimer}</span></div><ol class="process-steps">{processSteps.map((step,i)=><li data-step={i} class:list={[i===0&&'is-active']}><span class="step-num">{String(i+1).padStart(2,'0')}</span><div><span class="step-symbol"><Icon name={step.icon}/></span><h3>{step.title}</h3><p>{step.text}</p></div></li>)}</ol></div></section>
  <section class="section container simulator-preview"><div class="reveal"><p class="eyebrow">{home.simulator.eyebrow}</p><h2>{home.simulator.title}<br/><span>{home.simulator.titleAccent}</span></h2><p>{home.simulator.description}</p><a href={pathUrl('simulador/')} class="button primary">{home.simulator.button} <Icon name="arrow" size={20}/></a><p class="small">{home.simulator.privacy}</p></div><div class="preview-card reveal"><div class="card-top"><span class="eyebrow">Ejemplo referencial · Semanal</span><Icon name="sliders"/></div><div class="preview-amount"><span>Si simulas</span><b>{formatMoney(example.capital)}</b></div><div class="preview-line"><span>Tasa de la operación</span><b>{simulator.defaultRate}%</b></div><div class="preview-line"><span>Seguro ({simulator.insurancePercent}% del capital)</span><b>{formatMoney(example.insurance)}</b></div><div class="preview-result"><span>En {simulator.defaultCount} cuotas de</span><strong>{formatMoney(example.installments[0])}</strong><span>Total a pagar: {formatMoney(example.total)}</span></div><p class="small">{simulator.warning}</p></div></section>
  <section class="about-section"><div class="container about-grid"><div class="about-photo"><img src={photo} alt={images.commerceAlt} loading="lazy" decoding="async"/><span class="about-photo-label">{home.about.photoLabel}</span></div><div class="about-copy reveal"><p class="eyebrow">{home.about.eyebrow}</p><h2>{company.localTitle}</h2><p>{company.about}</p><a class="text-link" href={pathUrl('nosotros/')}>{home.about.link} <Icon name="arrow"/></a>{import.meta.env.DEV && <p class="draft-note">Contenido institucional ampliado pendiente de revisión. Los borradores se muestran solo en desarrollo.</p>}</div></div></section>
  <Testimonials/>
  <section class="section container faq-section" id="preguntas"><div class="reveal"><p class="eyebrow">{home.faq.eyebrow}</p><h2>{home.faq.title}<br/>{home.faq.titleAccent}</h2><p>{home.faq.description}</p><a class="text-link" href={pathUrl('contacto/')}>{home.faq.link} <Icon name="arrow" size={20}/></a></div><FAQ/></section>
  <ContactBand/>
</Layout>
