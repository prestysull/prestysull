---
import Layout from '../layouts/Layout.astro';
import WhatsApp from '../components/WhatsApp.astro';
import Icon from '../components/Icon.astro';
import {contact} from '../data/contacto';
---
<Layout title="Contacto y ubicación en Sullana" description="Consulta con Prestysull por WhatsApp al +51 945 396 704. Visítanos en San Martín 1094, Sullana, de lunes a sábados."><section class="container page-intro"><p class="eyebrow">Estamos cerca de ti</p><h1>Tu siguiente paso<br/><span>empieza aquí.</span></h1><p>Escríbenos o visítanos. Conversemos sobre la modalidad que te interesa.</p></section><section class="container section section-topless contact-page"><div class="contact-details"><div><span class="whatsapp-icon"><Icon name="chat" size={28}/></span><h2>Conversemos por WhatsApp</h2><p class="contact-phone">{contact.phone}</p><WhatsApp label="Consultar por WhatsApp"/></div><div><Icon name="clock" size={27}/><h2>Horario de atención</h2><p>{contact.days}<br/>{contact.hours}</p></div><div><h2>Redes sociales</h2><div class="social-links">{[['Facebook',contact.facebook],['TikTok',contact.tiktok]].map(([name,url])=>url?<a href={url} target="_blank" rel="noopener noreferrer">{name} ↗</a>:<span>{name}<small>Enlace por confirmar</small></span>)}</div></div></div><div class="location-card"><div class="location-art" aria-hidden="true"><div class="street street-a"></div><div class="street street-b"></div><div class="street street-c"></div><div class="map-block block-a"></div><div class="map-block block-b"></div><div class="map-block block-c"></div><div class="map-pin"><Icon name="pin" size={42}/></div><span>SULLANA</span></div><div class="location-info"><span class="eyebrow">Nuestra oficina</span><h2>{contact.address}</h2><p>{contact.city}<br/>Cobertura comercial: {contact.coverage}.</p><a href={contact.map} target="_blank" rel="noopener noreferrer" class="button primary">Ver dirección en Google Maps <Icon name="up" size={20}/></a><p class="small">La ilustración es decorativa. El enlace abre una búsqueda de la dirección; confirma la ubicación con un asesor.</p></div></div></section></Layout>
