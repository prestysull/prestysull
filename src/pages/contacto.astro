---
import Layout from '../layouts/Layout.astro';
import WhatsApp from '../components/WhatsApp.astro';
import Icon from '../components/Icon.astro';
import WhatsAppMark from '../components/WhatsAppMark.astro';
import {contact} from '../data/contacto';
const copy=contact.page;
---
<Layout title="Contacto y ubicación en Sullana" description="Consulta con Prestysull por WhatsApp al 945 396 704. Visítanos en San Martín 1094, Sullana, de lunes a sábados.">
  <section class="container page-intro"><p class="eyebrow">{copy.eyebrow}</p><h1>{copy.title}<br/><span>{copy.titleAccent}</span></h1><p>{copy.intro}</p></section>
  <section class="container section section-topless contact-page">
    <div class="contact-details">
      <div><span class="whatsapp-icon"><WhatsAppMark size={28}/></span><h2>{copy.whatsappTitle}</h2><p class="contact-phone">{contact.phone}</p><WhatsApp label="Consultar por WhatsApp"/></div>
      <div><Icon name="clock" size={27}/><h2>{copy.hoursTitle}</h2><p>{contact.days}<br/>{contact.hours}</p></div>
      <div><h2>{copy.socialTitle}</h2><div class="social-links">{[['Facebook',contact.facebook],['TikTok',contact.tiktok]].map(([name,url])=>url?<a href={url} target="_blank" rel="noopener noreferrer">{name} ↗</a>:<span>{name}<small>Enlace por confirmar</small></span>)}</div></div>
    </div>
    <div class="location-card">
      <div class="location-art" aria-hidden="true">
        <div class="street street-a"></div><div class="street street-b"></div><div class="street street-c"></div>
        <div class="map-block block-a"></div><div class="map-block block-b"></div><div class="map-block block-c"></div>
        <span class="map-chip"><span class="status-dot"></span>Oficina Prestysull</span>
        <svg class="map-route" viewBox="0 0 600 280" preserveAspectRatio="none"><path class="route-glow" d="M48 246C138 220 160 174 246 174S326 148 300 124"/><path class="route-line" d="M48 246C138 220 160 174 246 174S326 148 300 124"/><circle class="route-stop" cx="48" cy="246" r="5"/></svg>
        <div class="map-pin"><Icon name="pin" size={42}/></div><span class="map-city">SULLANA</span>
      </div>
      <div class="location-info"><span class="eyebrow">{copy.officeLabel}</span><h2>{contact.address}</h2><p>{contact.city}<br/>Cobertura comercial: {contact.coverage}.</p><a href={contact.map} target="_blank" rel="noopener noreferrer" class="button primary">{copy.mapsButton} <Icon name="up" size={20}/></a><p class="small">{copy.mapNote}</p></div>
    </div>
  </section>
</Layout>
