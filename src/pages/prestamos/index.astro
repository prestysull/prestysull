---
import Layout from '../../layouts/Layout.astro';
import LoanCards from '../../components/LoanCards.astro';
import ContactBand from '../../components/ContactBand.astro';
import Icon from '../../components/Icon.astro';
import {pathUrl} from '../../lib/links';
import {cmsContent} from '../../lib/content';
const copy=cmsContent.loans.overview;
---
<Layout title="Modalidades de préstamo en Sullana" description="Compara el préstamo semanal para comerciantes y el catorcenal para trabajadores dependientes. Conoce sus requisitos confirmados."><section class="page-intro container"><p class="eyebrow">{copy.eyebrow}</p><h1>{copy.title}<br/><span>{copy.titleAccent}</span></h1><p>{copy.description}</p></section><section class="container section section-topless"><LoanCards/><div class="notice"><Icon name="document"/><p>Capital mínimo: <strong>S/ 500.</strong> Los montos, tasas y plazos finales se determinan según evaluación.</p></div><a class="button outline" href={pathUrl('simulador/')}>{copy.simulatorButton} <Icon name="arrow"/></a></section><ContactBand/></Layout>
